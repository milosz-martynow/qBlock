# ============================================================
# qBlock Configuration File
# ============================================================
#
# Copy this file to .qblock.config and edit as needed.
#
# Lines starting with '#' are comments.
# Settings use 'key = value' format.
# Inline geometry is enclosed in $geometry ... $end markers.
#
# See compute/environment/configuration.py module docstring
# for full documentation of all recognised keys.
# ============================================================

# -- System ---------------------------------------------------

# basis_set: Global basis set applied to all atoms unless
#   overridden per-atom in the geometry block.
#   Supported: STO-3G, 3-21G, 6-31G, 6-311G, 6-311++G**
#   Default: STO-3G
basis_set = 3-21G

# charge: Total system charge (integer).
#   Default: 0
charge = 0

# multiplicity: Spin multiplicity 2S+1 (integer).
#   Default: 1
multiplicity = 1

# -- Geometry -------------------------------------------------
#
# Specify geometry inline OR via geometry_file, not both.
#
# geometry_file: Path to an XYZ file.
#   Example: geometry_file = geometries/water.xyz
#
# Inline geometry format (one atom per line):
#   Symbol  X  Y  Z  [basis_set]  [charge]
#
# Per-atom basis_set overrides the global value.
# Per-atom charge is the formal atomic charge (defaults to 0).

$geometry
H   0.000000   0.000000   0.000000
H   0.000000   0.000000   0.740000
$end

# -- Calculation ----------------------------------------------

# max_scf_iterations: Maximum SCF iterations (integer).
#   Default: 100
max_scf_iterations = 100

# scf_convergence_threshold: Convergence threshold (float).
#   Default: 1e-8
scf_convergence_threshold = 1e-8

# diis_start: Iteration to begin DIIS extrapolation (integer).
#   Default: 1
diis_start = 1

# diis_max_vectors: Maximum DIIS subspace size (integer).
#   Default: 6
diis_max_vectors = 6

# error_metric: Convergence metric (rms or max).
#   Default: rms
error_metric = rms

# -- Output ---------------------------------------------------

# output_dir: Directory for output files.
#   Default: output
output_dir = output

# log_level: Logging level (DEBUG, INFO, WARNING, ERROR).
#   Default: INFO
log_level = INFO

# save_json: Save JSON output (true/false).
#   Default: true
save_json = true

# save_text: Save text summary output (true/false).
#   Default: true
save_text = true
