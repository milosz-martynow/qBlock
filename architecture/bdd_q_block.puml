@startuml
' ==========================================================
' Block Definition Diagram for package q_block
' ==========================================================

package "q_block" {

    ' ----------------------------------------------------------
    ' models
    ' ----------------------------------------------------------

    class "Atom" {
        atomic_number: int
        charge: int
        maximal_principal_quantum_number: int
        shells: Dict<int, Shell>
        basis_set: Optional[BasisSet]
        coordinates: Optional[CartesianCoordinates]
        open_shell: Optional[bool]
        contracted_gaussian_type_orbitals: Optional<List<ContractedGaussianTypeOrbital>>
        --
        n_electrons: int <<property>>
        --
        fill_occupancy(): None
        to_bohr(): None
        make_contracted_gaussian_type_orbital(atom_index): None
    }

    class "SpinOrbital" {
        n: int
        l: int
        m: int
        s: float
        occupied: bool
        data: Optional[Any]
    }

    class "Orbital" {
        n: int
        l: int
        m: int
        spin_up: SpinOrbital
        spin_down: SpinOrbital
    }

    class "SubShell" {
        n: int
        l: int
        orbitals: List<Orbital>
    }

    class "Shell" {
        n: int
        subshells: List<SubShell>
    }

    ' ----------------------------------------------------------
    ' io
    ' ----------------------------------------------------------

    class "Coordinates" {
        as_tuple(): Tuple<float, float, float>
    }

    class "CartesianCoordinates" {
        x: float
        y: float
        z: float
        --
        {static} from_sequence(seq): CartesianCoordinates
        to_bohr(): CartesianCoordinates
        to_list(): List<float>
    }

    class "InputData" {
        atoms: pd.DataFrame
        --
        from_script(atom_data, atom_prefix): None
        from_xyz_file(xyz_path, atom_prefix): None
    }

    class "BasisSet" as BS {
        filepath: str
        data: BasisSetData
        --
        elements: List[str] <<property>>
        --
        {static} parse(filepath: str): BasisSetData
    }

    class "Pople" as BSP {
        {static} parse(filepath: str): BasisSetData
    }

    ' ----------------------------------------------------------
    ' systems
    ' ----------------------------------------------------------

    class "AtomicSystem" {
        input_data: InputData
        multiplicity: int
        is_restricted: Optional[bool]
        --
        charge: int <<property>>
    }

    class "Molecule" {
        atoms: List<Atom>
        contracted_gaussian_type_orbitals: Optional<List<ContractedGaussianTypeOrbital>>
        --
        total_atomic_number: int <<property>>
        n_electrons: int <<property>>
        n_basis: int <<property>>
        charge: int <<property>>
        --
        to_bohr(): None
        populate_spinorbitals_with_gto(): None
        validate_basis_sets(): None
        to_dataframe(): pd.DataFrame
        make_contracted_gaussian_type_orbital(): None
        molecular_orbital(r, coefficients, angular_components): float
    }

    class "Crystal" {
    }

    ' ----------------------------------------------------------
    ' theory.initialization (quantum_calculation_context)
    ' ----------------------------------------------------------

    class "QuantumCalculationContext" {
        molecule: Molecule
        charge: int
        multiplicity: int
        n_electrons: int
    }

    class "HartreeFock" {
        hf_method: HFMethod
        n_basis: int
        n_alpha: Optional[int]
        n_beta: Optional[int]
        --
        cgto: List<ContractedGaussianTypeOrbital> <<property>>
    }

    class "RHF" #LightGreen {
        n_occ: int
        n_alpha: int
        n_beta: int
    }

    class "UHF" #LightCoral {
        n_alpha: int
        n_beta: int
    }

    class "ROHF" #LightYellow {
        n_closed: int
        n_open: int
        n_alpha: int
        n_beta: int
    }

    ' ----------------------------------------------------------
    ' theory.basis_functions
    ' ----------------------------------------------------------

    class "ContractedGaussianTypeOrbital" as CGTO {
        center: CartesianCoordinates
        l: int
        exponents: List<float>
        contractions: List<float>
        atom_index: Optional<int>
        n_primitives: int
        n_functions: int
        --
        primitive_gaussian(r, primitive_index, lx, ly, lz): float
        basis_function(r, lx, ly, lz): float
    }

    ' ----------------------------------------------------------
    ' theory.integrals
    ' ----------------------------------------------------------

    abstract class "Integral" as INT {
        n_basis: int
        matrix: np.ndarray
        --
        {abstract} _compute_matrix(): np.ndarray
    }

    abstract class "TwoGaussianIntegral" as TGI {
        cgtos: List<ContractedGaussianTypeOrbital>
        n_basis: int
        matrix: np.ndarray
        --
        {static} _gaussian_product_center(alpha, A, beta, B): Tuple
        {static} _overlap_1d(l1, l2, PA, PB, gamma): float
        {static} _contract_primitives(cgtos, angular_momenta, kernel): float
        _compute_element(mu, nu): float
        _compute_matrix(): np.ndarray
    }

    class "Overlap" #LightBlue {
        matrix: np.ndarray
        --
        {static} primitive_overlap(...): float
        {static} contracted_overlap(...): float
    }

    class "KineticEnergy" #LightBlue {
        matrix: np.ndarray
        --
        {static} primitive_kinetic(...): float
        {static} contracted_kinetic(...): float
    }

    class "NuclearAttraction" #LightBlue {
        nuclei: List<Tuple<int, Tuple<float, float, float>>>
        matrix: np.ndarray
        --
        {static} primitive_nuclear_attraction(...): float
        {static} contracted_nuclear_attraction(...): float
        {static} _hermite_coulomb(...): float
        {static} _hermite_expansion_coefficient(...): float
    }

    class "TwoElectronRepulsion" #LightBlue {
        tensor: np.ndarray
        --
        {static} primitive_eri(...): float
        {static} contracted_eri(...): float
        {static} _hermite_coulomb(...): float
        {static} _hermite_expansion_coefficient(...): float
    }

    ' ----------------------------------------------------------
    ' theory.utils
    ' ----------------------------------------------------------

    class "utils" as TU <<module>> {
        {static} double_factorial(n): int
        {static} normalization_constant(alpha, lx, ly, lz): float
        {static} get_cartesian_components(l): List<Tuple<int, int, int>>
        {static} boys_function(n, x): float
    }

    ' ----------------------------------------------------------
    ' constants
    ' ----------------------------------------------------------

    class "atoms_data" as AD <<module>> {
        ATOMS_SYMBOLS_Z_TO_SYMBOL: Dict
        ATOMS_SYMBOLS_SYMBOL_TO_Z: Dict
        ANGULAR_MOMENTUM_MAP: Dict[str, int]
        EMPIRICAL_EXCEPTIONS: Dict[int, List[Dict[str, int]]]
        ANGSTROM_TO_BOHR: float
    }

    ' ----------------------------------------------------------
    ' Inheritance
    ' ----------------------------------------------------------

    CartesianCoordinates --|> Coordinates
    BSP                  --|> BS
    Molecule             --|> AtomicSystem
    Crystal              --|> AtomicSystem
    HartreeFock          --|> QuantumCalculationContext
    RHF                  --|> HartreeFock
    UHF                  --|> HartreeFock
    ROHF                 --|> HartreeFock
    TGI                  --|> INT
    Overlap              --|> TGI
    KineticEnergy        --|> TGI
    NuclearAttraction    --|> TGI
    TwoElectronRepulsion --|> TGI
}

' ----------------------------------------------------------
' Relationships
' ----------------------------------------------------------

"Atom"         "1" *--> "*" "Shell"
"Shell"        "1" *--> "*" "SubShell"
"SubShell"     "1" *--> "*" "Orbital"
"Orbital"      "1" *--> "2" "SpinOrbital"
"AtomicSystem" "1" *--> "*" "Atom"

"Atom"           ..> AD  : depends on
"Atom"           ..> "CartesianCoordinates" : uses
"Atom"           ..> CGTO : creates
"Molecule"       ..> BS  : uses
"Molecule"       ..> CGTO : aggregates
"QuantumCalculationContext" ..> "Molecule" : uses
"HartreeFock"    ..> BS  : uses
"HartreeFock"    ..> CGTO : uses (via Molecule)
CGTO             ..> "CartesianCoordinates" : uses

' Integral class dependencies
TGI              ..> CGTO : uses
TGI              ..> TU   : uses
Overlap          ..> TU   : uses (normalization_constant)
KineticEnergy    ..> TU   : uses (normalization_constant)
NuclearAttraction ..> TU  : uses (boys_function, normalization_constant)
TwoElectronRepulsion ..> TU : uses (boys_function, normalization_constant)

@enduml
