@startuml
' ==========================================================
' Block Definition Diagram for package q_block
' ==========================================================

package "q_block" {

    class "Atom" {
        atomic_number: int
        maximal_principal_quantum_number: int
        shells: Dict<int,Shell>
        empirical_exceptions: Optional[Dict<int,List<Dict<"n","l","electron_count">>>]
        basis_set: Optional[Dict]
        coordinates: Optional[CartesianCoordinates]
        fill_occupancy(): None
        populate_spinorbitals_with_gto(): None
        symbol: str
    }

    class "CartesianCoordinates" {
        x: float
        y: float
        z: float
    }

    class "Coordinates" {
        as_tuple(): Tuple<float, float, float>
    }

    class "SpinOrbital" {
        n: int
        l: int
        m: int
        s: float
        occupied: bool
        data: Optional[Any]
    }

    class "Orbital" {
        n: int
        l: int
        m: int
        spin_up: SpinOrbital
        spin_down: SpinOrbital
    }

    class "SubShell" {
        n: int
        l: int
        orbitals: List<Orbital>
    }

    class "Shell" {
        n: int
        subshells: List<SubShell>
    }

    class "Material" {
        atoms: List<Atom>
        total_charge: float
        atom_ids: Dict<int,Atom>
        add_atom(atom: Atom): int
        summary(): None
        from_xyz(path: str): Material
    }

    class "Molecule" {
    }

    class "Crystal" {
        lattice_vectors: Optional<Tuple<Vector,Vector,Vector>>
        pbc: Tuple<bool,bool,bool>
    }

    class "atoms_data" as AD <<module>> {
        ATOMS_SYMBOLS_Z_TO_SYMBOL: Dict
        ATOMS_SYMBOLS_SYMBOL_TO_Z: Dict
        ANGULAR_MOMENTUM_MAP: Dict[str,int]
        EMPIRICAL_EXCEPTIONS: Dict[int, List[Dict[str,int]]]
    }

    class "basis_set_pople" as BSP <<module>> {
        parse_gaussian_basis(filepath: str): BasisSet
    }

    Atom --> CartesianCoordinates : coordinates
    CartesianCoordinates --|> Coordinates
}

' ----------------------------------------------------------
' Relationships
' ----------------------------------------------------------

"Atom" "1" *-- "*" "Shell"
"Shell" "1" *-- "*" "SubShell"
"SubShell" "1" *-- "*" "Orbital"
"Orbital" "1" *-- "2" "SpinOrbital"

"Material" "1" *-- "*" "Atom"

"Molecule" --|> "Material"
"Crystal"  --|> "Material"

"Atom" ..> AD  : depends on
"Atom" ..> BSP : depends on

@enduml
