@startuml
' ==========================================================
' Block Definition Diagram for package q_block
' ==========================================================

package "q_block" {

    ' ----------------------------------------------------------
    ' models
    ' ----------------------------------------------------------

    class "Atom" {
        atomic_number: int
        charge: int
        maximal_principal_quantum_number: int
        shells: Dict<int, Shell>
        basis_set: Optional[BasisSet]
        coordinates: Optional[CartesianCoordinates]
        open_shell: Optional[bool]
        contracted_gaussian_type_orbitals: Optional<List<ContractedGaussianTypeOrbital>>
        --
        n_electrons: int <<property>>
        --
        fill_occupancy(): None
        to_bohr(): None
        make_contracted_gaussian_type_orbital(atom_index): None
    }

    class "SpinOrbital" {
        n: int
        l: int
        m: int
        s: float
        occupied: bool
        data: Optional[Any]
    }

    class "Orbital" {
        n: int
        l: int
        m: int
        spin_up: SpinOrbital
        spin_down: SpinOrbital
    }

    class "SubShell" {
        n: int
        l: int
        orbitals: List<Orbital>
    }

    class "Shell" {
        n: int
        subshells: List<SubShell>
    }

    ' ----------------------------------------------------------
    ' io
    ' ----------------------------------------------------------

    class "Coordinates" {
        as_tuple(): Tuple<float, float, float>
    }

    class "CartesianCoordinates" {
        x: float
        y: float
        z: float
        --
        {static} from_sequence(seq): CartesianCoordinates
        to_bohr(): CartesianCoordinates
        to_list(): List<float>
    }

    class "InputData" {
        atoms: pd.DataFrame
        --
        from_script(atom_data, atom_prefix): None
        from_xyz_file(xyz_path, atom_prefix): None
    }

    class "BasisSet" as BS {
        filepath: str
        data: BasisSetData
        --
        elements: List[str] <<property>>
        --
        {static} parse(filepath: str): BasisSetData
    }

    class "Pople" as BSP {
        {static} parse(filepath: str): BasisSetData
    }

    ' ----------------------------------------------------------
    ' systems
    ' ----------------------------------------------------------

    class "AtomicSystem" {
        input_data: InputData
        multiplicity: int
        is_restricted: Optional[bool]
        --
        charge: int <<property>>
    }

    class "Molecule" {
        atoms: List<Atom>
        contracted_gaussian_type_orbitals: Optional<List<ContractedGaussianTypeOrbital>>
        --
        total_atomic_number: int <<property>>
        n_electrons: int <<property>>
        n_basis: int <<property>>
        charge: int <<property>>
        --
        to_bohr(): None
        populate_spinorbitals_with_gto(): None
        validate_basis_sets(): None
        to_dataframe(): pd.DataFrame
        make_contracted_gaussian_type_orbital(): None
        molecular_orbital(r, coefficients, angular_components): float
    }

    class "Crystal" {
    }

    ' ----------------------------------------------------------
    ' theory.initialization
    ' ----------------------------------------------------------

    class "Initialization" {
        molecule: Molecule
        charge: int
        multiplicity: int
        n_electrons: int
    }

    class "HartreeFock" {
        hf_method: HFMethod
        n_basis: int
        n_alpha: Optional[int]
        n_beta: Optional[int]
    }

    class "RHF" #LightGreen {
        n_occ: int
        n_alpha: int
        n_beta: int
    }

    class "UHF" #LightCoral {
        n_alpha: int
        n_beta: int
    }

    class "ROHF" #LightYellow {
        n_closed: int
        n_open: int
        n_alpha: int
        n_beta: int
    }

    ' ----------------------------------------------------------
    ' theory.basis_functions
    ' ----------------------------------------------------------

    class "ContractedGaussianTypeOrbital" as CGTO {
        center: CartesianCoordinates
        l: int
        exponents: List<float>
        contractions: List<float>
        atom_index: Optional<int>
        n_primitives: int
        n_functions: int
        --
        primitive_gaussian(r, primitive_index, lx, ly, lz): float
        basis_function(r, lx, ly, lz): float
    }

    ' ----------------------------------------------------------
    ' constants
    ' ----------------------------------------------------------

    class "atoms_data" as AD <<module>> {
        ATOMS_SYMBOLS_Z_TO_SYMBOL: Dict
        ATOMS_SYMBOLS_SYMBOL_TO_Z: Dict
        ANGULAR_MOMENTUM_MAP: Dict[str, int]
        EMPIRICAL_EXCEPTIONS: Dict[int, List[Dict[str, int]]]
        ANGSTROM_TO_BOHR: float
    }

    ' ----------------------------------------------------------
    ' Inheritance
    ' ----------------------------------------------------------

    CartesianCoordinates --|> Coordinates
    BSP                  --|> BS
    Molecule             --|> AtomicSystem
    Crystal              --|> AtomicSystem
    HartreeFock          --|> Initialization
    RHF                  --|> HartreeFock
    UHF                  --|> HartreeFock
    ROHF                 --|> HartreeFock
}

' ----------------------------------------------------------
' Relationships
' ----------------------------------------------------------

"Atom"         "1" *--> "*" "Shell"
"Shell"        "1" *--> "*" "SubShell"
"SubShell"     "1" *--> "*" "Orbital"
"Orbital"      "1" *--> "2" "SpinOrbital"
"AtomicSystem" "1" *--> "*" "Atom"

"Atom"           ..> AD  : depends on
"Atom"           ..> "CartesianCoordinates" : uses
"Atom"           ..> CGTO : creates
"Molecule"       ..> BS  : uses
"Molecule"       ..> CGTO : aggregates
"Initialization" ..> "Molecule" : uses
"HartreeFock"    ..> BS  : uses
"HartreeFock"    ..> CGTO : uses (via Molecule)
CGTO             ..> "CartesianCoordinates" : uses

@enduml
