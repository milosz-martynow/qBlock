@startuml
' Activity diagram showing a typical sequence of actions in q_block
start
:Parse basis files (optional)\n(parse_gaussian_basis from q_block.basis_set_pople);
if (basis file present?) then (yes)
  :Load BasisSet (regions by l);
else (no)
  :basis_set := None;
endif
:Instantiate Atom(Z, basis_set) [q_block.atom];
:Atom constructs Shell/SubShell/Orbital/SpinOrbital (from q_block.electron);
:Atom.fill_occupancy();
if (use empirical exception for Z?) then (yes)
  :Atom._apply_exception(...)\n(assign specific subshell counts);
else (no)
  :Apply Aufbau ordering (sort by n+l, n);
  :Apply Hund's rule (single occupancy then pairing);
endif
:Check occupied subshells;
if (basis_set is not None) then (yes)
  :Atom.populate_spinorbitals_with_gto();
  :Group occupied subshells by l;\n  :assign basis shells;\n  :set SpinOrbital.data (attached to q_block.electron instances);
else (no)
  :Skip GTO population;
endif
stop
@enduml
