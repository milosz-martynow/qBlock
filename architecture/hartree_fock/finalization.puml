@startuml Finalization

skinparam ActivityBackgroundColor White
skinparam ActivityBorderColor Black

!startsub FINALIZATION
partition "Finalization" {
    :<latex>E_{total} = E_{elec} + E_{nuc}</latex>;
    
    switch (HF Method?)
    case (RHF)
        :Create RestrictedClosedShell
        wavefunction object; <<#LightGreen>>
        :Store <latex>\mathbf{C}, \boldsymbol{\varepsilon}, \mathbf{P}</latex>; <<#LightGreen>>
        
    case (UHF)
        :Create UnrestrictedOpenShell
        wavefunction object; <<#LightCoral>>
        :Store <latex>\mathbf{C}^{\alpha}, \mathbf{C}^{\beta}</latex>
        <latex>\boldsymbol{\varepsilon}^{\alpha}, \boldsymbol{\varepsilon}^{\beta}</latex>
        <latex>\mathbf{P}^{\alpha}, \mathbf{P}^{\beta}, \langle\hat{S}^2\rangle</latex>; <<#LightCoral>>
        
    case (ROHF)
        :Create RestrictedOpenShell
        wavefunction object; <<#LightYellow>>
        :Store <latex>\mathbf{C}, \boldsymbol{\varepsilon}</latex>
        orbital classifications
        (closed/open/virtual); <<#LightYellow>>
    endswitch
    
    :Package HartreeFockResults
    (energies, matrices, convergence info);
}
!endsub

legend right
    **Symbol Legend:**
    |= Symbol |= Description |
    | <latex>E_{total}</latex> | Total molecular energy (electronic + nuclear) |
    | <latex>E_{elec}</latex> | Electronic energy - energy of all electrons |
    | <latex>E_{nuc}</latex> | Nuclear repulsion energy - classical nucleus-nucleus repulsion |
    | <latex>\mathbf{C}</latex> | MO coefficient matrix - orbital expansion coefficients |
    | <latex>\mathbf{C}^{\alpha}, \mathbf{C}^{\beta}</latex> | Spin-specific MO coefficients (UHF) |
    | <latex>\boldsymbol{\varepsilon}</latex> | Orbital energies - eigenvalues of Fock matrix |
    | <latex>\boldsymbol{\varepsilon}^{\alpha}, \boldsymbol{\varepsilon}^{\beta}</latex> | Spin-specific orbital energies (UHF) |
    | <latex>\mathbf{P}</latex> | Density matrix - electron probability distribution |
    | <latex>\mathbf{P}^{\alpha}, \mathbf{P}^{\beta}</latex> | Spin-specific density matrices (UHF) |
    | <latex>\langle\hat{S}^2\rangle</latex> | Spin expectation value - spin purity measure |
    | Wavefunction | Object containing all orbital and energy information |
    | HartreeFockResults | Container for all calculation outputs |
    ----
    **HF Method Colors:**
    |<#LightGreen> RHF | Restricted Closed-Shell |
    |<#LightCoral> UHF | Unrestricted Open-Shell |
    |<#LightYellow> ROHF | Restricted Open-Shell |
endlegend

@enduml
