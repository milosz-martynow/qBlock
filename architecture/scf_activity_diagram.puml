@startuml scf_activity_diagram
title qBlock — Generic SCF Algorithm

start

partition "SCF.initialization  (integral computation)" {
  :Overlap(cgtos) → **S**
  <latex>S_{\mu\nu} = \langle \mu | \nu \rangle</latex>;
  :Diagonalize overlap matrix
  <latex>\mathbf{X} = \mathbf{S}^{-1/2}</latex>;
  :KineticEnergy(cgtos) → **T**
  <latex>T_{\mu\nu} = \langle \mu | -\tfrac{1}{2}\nabla^2 | \nu \rangle</latex>;
  :NuclearAttraction(cgtos, nuclei) → **V**
  <latex>V_{\mu\nu} = \sum_A \langle \mu | -\frac{Z_A}{|\mathbf{r}-\mathbf{R}_A|} | \nu \rangle</latex>;
  :Calculate core Hamiltonian
  <latex>\mathbf{H} = \mathbf{T} + \mathbf{V}</latex>;
  :TwoElectronRepulsion(cgtos) → **eri**
  <latex>(\mu\nu|\lambda\sigma) = \iint \frac{\mu(\mathbf{r}_1)\nu(\mathbf{r}_1)\lambda(\mathbf{r}_2)\sigma(\mathbf{r}_2)}{|\mathbf{r}_1-\mathbf{r}_2|} d\mathbf{r}_1 d\mathbf{r}_2</latex>;
  :DIIS(max_vectors) → **diis**;
  :CalculationErrorMetric(metric) → **calculation_error_metric**;
}

partition "SCF.run()" {

  :C, epsilon = diagonalise_fock(**H**, **X**)
  <latex>\mathbf{X}^T \mathbf{H} \mathbf{X} \mathbf{C'} = \mathbf{C'} \boldsymbol{\varepsilon} \;\;\rightarrow\;\; \mathbf{C} = \mathbf{X}\mathbf{C'}</latex>;
  :density = _initial_density(C)
  <latex>P_{\mu\nu} = \sum_{i}^{occ} C_{\mu i} C_{\nu i}</latex>;
  :e_electronic_old = 0.0;

  while (iteration < max_iterations) is (next iteration)

    :fock = _build_fock(density)
    <latex>F_{\mu\nu} = H_{\mu\nu} + \sum_{\lambda\sigma} P_{\lambda\sigma} \big[ (\mu\nu|\lambda\sigma) - (\mu\sigma|\lambda\nu) \big]</latex>;
    :e_electronic = _compute_electronic_energy(density, fock)
    <latex>E_{elec} = \tfrac{1}{2} \mathrm{tr}\!\big[\mathbf{P}(\mathbf{H}+\mathbf{F})\big]</latex>;
    :commutator_error = diis.compute_error(fock, density, **S**)
    <latex>\mathbf{e} = \mathbf{F}\mathbf{P}\mathbf{S} - \mathbf{S}\mathbf{P}\mathbf{F}</latex>;

    if (iteration >= diis_start ?) then (yes)
      :fock = diis.extrapolate(fock, commutator_error);
    else (no)
    endif

    :electronic_energy_change = e_electronic − e_electronic_old
    <latex>\Delta E = E_{elec} - E_{elec}^{old}</latex>;
    :computation_error = calculation_error_metric.compute(commutator_error);

    if (|electronic_energy_change| < convergence_threshold\nAND computation_error < convergence_threshold ?) then (yes)
      :C, epsilon = diagonalise_fock(fock, **X**);
      :density = _build_density(C);
      :_collect_results(converged=True, ...);
      stop
    else (no)
    endif

    :C, epsilon = diagonalise_fock(fock, **X**);
    :density = _build_density(C);
    :e_electronic_old = e_electronic;

  endwhile (max_iterations exhausted)

  :_collect_results(converged=False, ...);
}

stop

@enduml
