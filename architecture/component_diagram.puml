@startuml component_diagram


' ═══════════════════════════════════════════════════════════
' Component Definitions
' ═══════════════════════════════════════════════════════════

package "qBlock" {

  component [Environment] as environment #E8F4F8 {
    [constants]
    [io]
    [configuration]
  }
  component [Models] as models #E8F4F8
  component [Solvers] as solvers #E8F4F8
  component [Utilities] as utilities #E8F4F8

}

' ═══════════════════════════════════════════════════════════
' Dependencies and Relationships
' ═══════════════════════════════════════════════════════════

' Component dependencies
environment <..> models
environment <..> utilities
models <..> utilities
solvers ..> environment
solvers ..> models
solvers ..> utilities

@enduml
