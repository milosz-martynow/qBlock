@startuml bdd_methods
title BDD — methods

package "methods" {
  abstract class SCF
  class DIIS
  class CalculationErrorMetric

  package "wavefunction / hartree_fock" {
    class "HartreeFock\n(Wavefunction)" as HFWave
    class RestrictedHartreeFock <<RHF>>
    class UnrestrictedHartreeFock <<UHF>>
    class RestrictedOpenShellHartreeFock <<ROHF>>
    class SpinPair
  }
}

' --- External blocks ---
class ContractedGaussianTypeOrbital <<theory>>
class Overlap <<theory.integrals>>
class KineticEnergy <<theory.integrals>>
class NuclearAttraction <<theory.integrals>>
class TwoElectronRepulsion <<theory.integrals>>

' ═══ Generalization ═══

HFWave -up-|> SCF
RestrictedHartreeFock -up-|> HFWave
UnrestrictedHartreeFock -up-|> HFWave
RestrictedOpenShellHartreeFock -up-|> HFWave

' ═══ Composition ═══

SCF *-- "1" DIIS
SCF *-- "1" CalculationErrorMetric

' ═══ Use ═══

SCF ..> ContractedGaussianTypeOrbital : «use»
SCF ..> Overlap : «use»
SCF ..> KineticEnergy : «use»
SCF ..> NuclearAttraction : «use»
SCF ..> TwoElectronRepulsion : «use»
HFWave ..> SpinPair : «use»

@enduml
