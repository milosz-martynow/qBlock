@startuml Generic SCF Algorithm

' Activity diagram for q_block/methods/scf.py
' SCF (abstract) — Template Method pattern
' Orange = abstract hooks overridden by RHF / UHF / ROHF

skinparam ActivityBackgroundColor White
skinparam ActivityBorderColor Black

title Generic SCF Algorithm (q_block.methods.scf)

start

partition "Integral Computation" {
    :Compute **S**, **T**, **V**, **ERI**;
    :Assemble core Hamiltonian **H** = **T** + **V**;
    :Compute orthogonalisation matrix **X** = **S**^(-1/2);
}

partition "SCF Initialisation" {
    :Initial Fock guess **F** = **H**;
    :Diagonalise **F** via **X** to get **C**, epsilon;
    :_initial_density(**C**) — Build initial **P**; <<#Orange>>
    :Initialise DIIS;
    :E_old = 0;
}

partition "SCF Iteration Loop" {
    repeat

        :_build_fock(**P**) — Assemble Fock matrix **F**; <<#Orange>>

        :_compute_electronic_energy(**P**, **F**) — Evaluate E_elec; <<#Orange>>

        :DIIS.compute_error(**F**, **P**, **S**) — Compute error **e**;

        if (iteration >= diis_start?) then (yes)
            :DIIS extrapolation
            **F** = sum( c_i * F_i );
        else (no)
        endif

        :dE = E_elec - E_old;
        :RMS = rms(**e**);

        if (|dE| < threshold AND RMS < threshold?) then (converged)
            break
        else (not converged)
        endif

        :Diagonalise **F** via **X** to get **C**, epsilon;

        :_build_density(**C**) — Build new **P**; <<#Orange>>

        :E_old = E_elec;

    repeat while (iteration < max_iterations?) is (yes)
    -> no;

    :SCF **not converged**;
}

partition "Convergence" {
    :Final diagonalisation of **F**;

    :_build_density(**C**) — Final **P** from converged MOs; <<#Orange>>
}

partition "Result" {
    :E_total = E_elec + E_nuc;

    :_collect_results(...) — Populate result attributes on **self**; <<#Orange>>
}

stop

legend right
    |= Colour |= Meaning |
    |<#Orange> Orange | Abstract hook (subclass) |
    |<#White> White | Common SCF logic |
    ----
    |= Hook |= Purpose |
    | _build_fock(P) | Assemble Fock matrix |
    | _compute_electronic_energy(P, F) | Evaluate E_elec |
    | _build_density(C) | Construct P from MOs |
    | _initial_density(C) | Initial density guess |

    | _collect_results(...) | Store results on self |
endlegend

@enduml
